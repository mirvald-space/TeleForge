# Start handler
msgid "👋 Hello, {full_name}!\n\nWelcome to the bot. Use /help to see available commands."
msgstr "👋 Hello, {full_name}!\n\nWelcome to the bot. Use /help to see available commands."

# Help handler
msgid "📚 <b>Available commands:</b>\n\n/start - Start the bot\n/help - Show this help message\n/language - Change language"
msgstr "📚 <b>Available commands:</b>\n\n/start - Start the bot\n/help - Show this help message\n/language - Change language"

# Language handler
msgid "🌐 Please select your language:"
msgstr "🌐 Please select your language:"

msgid "Language changed"
msgstr "Language changed"

msgid "✅ Your language has been set to: {language}"
msgstr "✅ Your language has been set to: {language}"

msgid "English"
msgstr "English"

msgid "Russian"
msgstr "Russian"

msgid "Ukrainian"
msgstr "Ukrainian"

# Echo handler
msgid "I don't understand this command. Use /help to see available commands."
msgstr "I don't understand this command. Use /help to see available commands."

# Throttling middleware
msgid "Please don't spam! Wait a moment before sending another message."
msgstr "Please don't spam! Wait a moment before sending another message." 