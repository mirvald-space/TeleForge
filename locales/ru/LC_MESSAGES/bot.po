# Start handler
msgid "👋 Hello, {full_name}!\n\nWelcome to the bot. Use /help to see available commands."
msgstr "👋 Привет, {full_name}!\n\nДобро пожаловать в бота. Используйте /help, чтобы увидеть доступные команды."

# Help handler
msgid "📚 <b>Available commands:</b>\n\n/start - Start the bot\n/help - Show this help message\n/language - Change language"
msgstr "📚 <b>Доступные команды:</b>\n\n/start - Запустить бота\n/help - Показать эту справку\n/language - Изменить язык"

# Language handler
msgid "🌐 Please select your language:"
msgstr "🌐 Пожалуйста, выберите ваш язык:"

msgid "Language changed"
msgstr "Язык изменен"

msgid "✅ Your language has been set to: {language}"
msgstr "✅ Ваш язык установлен на: {language}"

msgid "English"
msgstr "Английский"

msgid "Russian"
msgstr "Русский"

msgid "Ukrainian"
msgstr "Украинский"

# Echo handler
msgid "I don't understand this command. Use /help to see available commands."
msgstr "Я не понимаю эту команду. Используйте /help, чтобы увидеть доступные команды."

# Throttling middleware
msgid "Please don't spam! Wait a moment before sending another message."
msgstr "Пожалуйста, не спамьте! Подождите немного перед отправкой следующего сообщения." 