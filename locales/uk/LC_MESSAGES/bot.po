# Start handler
msgid "👋 Hello, {full_name}!\n\nWelcome to the bot. Use /help to see available commands."
msgstr "👋 Привіт, {full_name}!\n\nЛаскаво просимо до бота. Використовуйте /help, щоб побачити доступні команди."

# Help handler
msgid "📚 <b>Available commands:</b>\n\n/start - Start the bot\n/help - Show this help message\n/language - Change language"
msgstr "📚 <b>Доступні команди:</b>\n\n/start - Запустити бота\n/help - Показати цю довідку\n/language - Змінити мову"

# Language handler
msgid "🌐 Please select your language:"
msgstr "🌐 Будь ласка, виберіть вашу мову:"

msgid "Language changed"
msgstr "Мову змінено"

msgid "✅ Your language has been set to: {language}"
msgstr "✅ Вашу мову встановлено на: {language}"

msgid "English"
msgstr "Англійська"

msgid "Russian"
msgstr "Російська"

msgid "Ukrainian"
msgstr "Українська"

# Echo handler
msgid "I don't understand this command. Use /help to see available commands."
msgstr "Я не розумію цю команду. Використовуйте /help, щоб побачити доступні команди."

# Throttling middleware
msgid "Please don't spam! Wait a moment before sending another message."
msgstr "Будь ласка, не спамте! Зачекайте трохи перед надсиланням наступного повідомлення." 